[Desktop Entry]
Type=Application
Version=1.5
Name=calibre-rust
GenericName=Ebook Library
Comment=Manage, read, edit, and convert ebooks
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/calibre-rust\\" -- \\"\\$@\\"" calibre-rust %U
Icon=calibre-rust
Terminal=false
StartupNotify=true
StartupWMClass=calibre-rust
Categories=Office;Viewer;
Keywords=ebook;books;library;reader;EPUB;Kindle;Kobo;
MimeType=application/epub+zip;application/pdf;application/x-mobipocket-ebook;application/vnd.amazon.mobi8-ebook;application/x-fictionbook+xml;application/vnd.comicbook+zip;application/vnd.comicbook-rar;application/x-kobo-epub+zip;application/x-calibre-htmlz;
Actions=OpenLibrary;AddBooks;ReadBook;Preferences;

[Desktop Action OpenLibrary]
Name=Open Library…
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/calibre-rust\\" --choose-library"

[Desktop Action AddBooks]
Name=Add Books…
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/calibre-rust\\" --add-books"

[Desktop Action ReadBook]
Name=Open Book File…
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/calibre-rust\\" --open-book"

[Desktop Action Preferences]
Name=Preferences
Exec=/bin/sh -c "exec \\"\\$HOME/.local/bin/calibre-rust\\" --preferences"
